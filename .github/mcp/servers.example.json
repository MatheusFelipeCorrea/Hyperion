{
  "mcpServers": {
    "jira": {
      "command": "npx",
      "args": ["-y", "mcp-atlassian"],
      "env": {
        "ATLASSIAN_BASE_URL": "${JIRA_URL}",
        "ATLASSIAN_EMAIL": "${JIRA_EMAIL}",
        "ATLASSIAN_API_TOKEN": "${JIRA_API_TOKEN}"
      }
    },
    "linear": {
      "command": "npx",
      "args": ["-y", "mcp-linear"],
      "env": {
        "LINEAR_API_KEY": "${LINEAR_API_KEY}"
      }
    },
    "azure-devops": {
      "command": "npx",
      "args": ["-y", "@azure-devops/mcp", "<your-organization-name>"],
      "_comment": "Official Microsoft server (github.com/microsoft/azure-devops-mcp). Replace <your-organization-name> literally — it's a CLI arg, not an env var. Auths via Azure CLI (`az login`) by default; see the package's own README for PAT-based auth if you can't use az login."
    },
    "gitlab": {
      "command": "npx",
      "args": ["-y", "mcp-gitlab"],
      "env": {
        "GITLAB_TOKEN": "${GITLAB_TOKEN}",
        "GITLAB_URL": "${GITLAB_URL}"
      }
    }
  }
}
