{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/local/.github/project.schema.json",
  "title": "Portable project contract for .github agents and skills",
  "description": "Generic, optional-first contract so agents/skills work in any repository. Omit sections that do not apply; prefer discovery when a path is absent.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Schema version of this contract."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable project or product name."
    },
    "kit": {
      "type": "object",
      "additionalProperties": false,
      "description": "Where the Hyperion kit folder lives inside the product repo. Omit when the kit is at the workspace root (legacy / upstream).",
      "properties": {
        "root": {
          "type": "string",
          "description": "Relative path from the product repo root to the kit folder (e.g. Hyperion). Cards/skills live under {root}/.github/."
        }
      }
    },
    "locale": {
      "type": "string",
      "minLength": 2,
      "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
      "description": "Primary language (BCP 47 tag: pt-BR, en, es, fr…) for everything people read: PRs, commit subjects, cards, specs, docs, CI comments, CLI. Any language works for agent-written text; fixed script strings ship in en, pt-BR and es (others fall back to en unless .github/i18n/<tag>.json exists)."
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
      "description": "All languages the team reads, primary first (must equal locale). More than one = multilingual: surfaces in i18n.multilingual get the primary text plus collapsed <details> translations."
    },
    "i18n": {
      "type": "object",
      "additionalProperties": false,
      "description": "Language behaviour beyond locale/languages.",
      "properties": {
        "multilingual": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["pr", "comments", "release", "docs", "issues"] },
          "description": "Surfaces rendered in every language when languages has more than one entry (default: pr, comments, release). Cards, specs and plans stay in the primary language unless issues is listed."
        }
      }
    },
    "layout": {
      "type": "string",
      "enum": ["single", "monorepo", "multi-package"],
      "description": "Workspace shape. Omit or use single for a simple app repo."
    },
    "apps": {
      "type": "object",
      "description": "Named applications or packages. Keys are free-form ids (api, web, mobile, …).",
      "additionalProperties": {
        "$ref": "#/$defs/app"
      }
    },
    "docs": {
      "type": "object",
      "additionalProperties": false,
      "description": "Paths to documentation. All fields optional for simple repos.",
      "properties": {
        "root": {
          "type": "string",
          "description": "Documentation root directory."
        },
        "requirements": {
          "type": ["string", "null"],
          "description": "Requirements backlog or index file. null means intentionally unset (see project.example.yml)."
        },
        "api_readme": {
          "type": "string",
          "description": "API / backend engineering README."
        },
        "web_readme": {
          "type": "string",
          "description": "Web / frontend engineering README."
        },
        "blueprints": {
          "type": "string",
          "description": "Directory (or file) for architecture/folder blueprints."
        },
        "diagrams": {
          "type": ["string", "null"],
          "description": "Directory for diagrams (PlantUML, C4, etc.). null means intentionally unset (see project.example.yml)."
        },
        "historical_audits": {
          "type": "string",
          "description": "Directory of past audit reports (read-only reference)."
        },
        "commits_guide": {
          "type": "string",
          "description": "Optional commit message / Refs guide."
        },
        "business_rules": {
          "type": "string",
          "description": "Optional business rules document."
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "description": "Where agents write new artifacts. Relative POSIX paths.",
      "properties": {
        "audits": {
          "type": "string",
          "description": "Root for new audit reports (often .github/audits/results)."
        },
        "cards": {
          "type": "string",
          "description": "Epic / story cards directory."
        },
        "implementations": {
          "type": "string",
          "description": "Phased implementation plans directory."
        },
        "diagrams": {
          "type": "string",
          "description": "Override for generated diagrams if distinct from docs.diagrams."
        }
      }
    },
    "stack_hints": {
      "type": "array",
      "description": "Optional technology hints. Never treat as hard requirements.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "conventions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requirement_prefixes": {
          "type": "array",
          "description": "Prefixes for requirement IDs (e.g. RF, RNF, US).",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "finding_prefixes": {
          "type": "object",
          "description": "Map audit id (from audits/manifest.yml) → finding ID prefix.",
          "additionalProperties": {
            "type": ["string", "null"],
            "minLength": 1
          }
        },
        "commit_refs_style": {
          "type": "string",
          "description": "Optional note on how Refs appear in commits."
        }
      }
    },
    "audits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "overlay": {
          "type": ["string", "null"],
          "description": "Optional markdown with project-specific audit context. null means intentionally unset (see project.example.yml)."
        },
        "manifest": {
          "type": "string",
          "description": "Override path to audits manifest (default .github/audits/manifest.yml)."
        }
      }
    },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "description": "CI/CD policy — Hyperion never overwrites non-hyperion workflows when policy is detect (default).",
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["github-actions", "gitlab-ci", "azure-pipelines", "circleci", "jenkins", "bitbucket", "none"],
          "description": "Detected or configured CI provider."
        },
        "policy": {
          "type": "string",
          "enum": ["detect", "hyperion-only", "merge", "skip"],
          "description": "detect=add hyperion-* only; skip=no workflow writes; hyperion-only=generate product CI if absent; merge=manual integration."
        },
        "stack": {
          "type": "string",
          "description": "Stack hint for generated CI: auto, node-npm, python, docker, go, rust, unknown."
        },
        "existing": {
          "type": "array",
          "description": "Paths to existing product CI files (informational; populated by discovery).",
          "items": { "type": "string" }
        },
        "hyperion": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cards_sync": {
              "type": "boolean",
              "description": "Install hyperion-sync-cards.yml."
            },
            "kit_validation": {
              "type": "boolean",
              "description": "Install hyperion-validate.yml (kit maintainer checks)."
            },
            "security_scan": {
              "type": "boolean",
              "description": "Install hyperion-security.yml."
            },
            "product_ci": {
              "enum": ["auto", "true", "false", true, false],
              "description": "auto=generate hyperion-product-ci.yml only when no product CI exists; true=always (hyperion-* file only); false=never."
            },
            "cards_sync_mode": {
              "enum": ["pull-forward", "auto"],
              "default": "pull-forward",
              "description": "pull-forward=sync on push to the default branch (board drift blocks PRs); auto=bidirectional reconcile on push, issue events and a schedule, committing board status/sprint back to markdown ([cards-sync] commits; the PR guard ignores status/sprint drift)."
            }
          }
        },
        "gates": {
          "type": "object",
          "additionalProperties": false,
          "description": "Quality gates accepted in the /pipeline interview. When present, hyperion-product-ci.yml is rendered from these decisions (npm run hyperion:pipeline-gates lists what the repo supports).",
          "properties": {
            "preset": {
              "enum": ["minimal", "balanced", "strict"],
              "description": "Starting point; every explicit key below wins. minimal=lint/test/build; balanced=+coverage warn, audit, secrets, PR hygiene, Docker cache; strict=all block, diff coverage, Lighthouse/a11y, notifications."
            },
            "declined": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Interview question ids the team declined (not asked again by --pending)."
            },
            "branches": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Branches that run the gates on push (default: repository default branch)."
            },
            "merge_group": {
              "type": "boolean",
              "description": "Also run on the GitHub merge queue (default true)."
            },
            "runner": {
              "type": "string",
              "description": "Default runs-on label (default ubuntu-latest)."
            },
            "timeout_minutes": {
              "type": "integer",
              "minimum": 1,
              "description": "Default per-job timeout (default 30)."
            },
            "affected": {
              "anyOf": [
                { "type": "boolean" },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "enabled": { "type": "boolean" },
                    "paths": { "type": "array", "items": { "type": "string" }, "description": "Shared paths that trigger every app." }
                  }
                }
              ],
              "description": "On PRs, run only apps whose files changed (dorny/paths-filter). Pushes and the merge queue run everything."
            },
            "artifacts": {
              "type": "boolean",
              "description": "Upload coverage/test reports as Actions artifacts (7 days)."
            },
            "pull_request": {
              "type": "boolean",
              "description": "Run the gates on pull requests (default true)."
            },
            "paths_ignore": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Paths that do not trigger the pipeline (e.g. **/*.md)."
            },
            "defaults": {
              "$ref": "#/$defs/gateSet",
              "description": "Gate modes applied to every detected app unless overridden in apps.<name>."
            },
            "apps": {
              "type": "object",
              "description": "Per-app overrides keyed by app name (from pipeline-gates). Use `<name>: off` to exclude an app.",
              "additionalProperties": {
                "anyOf": [{ "$ref": "#/$defs/gateApp" }, { "$ref": "#/$defs/gateMode" }]
              }
            },
            "docker": {
              "anyOf": [
                { "$ref": "#/$defs/gateMode" },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "build": { "$ref": "#/$defs/gateMode" },
                    "scan": { "$ref": "#/$defs/gateMode" },
                    "severity": { "type": "string", "description": "Trivy severities (default HIGH,CRITICAL)." },
                    "files": { "type": "array", "items": { "type": "string" }, "description": "Limit to these Dockerfiles." },
                    "lint": { "$ref": "#/$defs/gateMode", "description": "hadolint (respects .hadolint.yaml)." },
                    "cache": { "type": "boolean", "description": "buildx with the GitHub Actions cache (type=gha)." },
                    "publish": {
                      "anyOf": [
                        { "type": "boolean" },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "branches": { "type": "array", "items": { "type": "string" }, "description": "Branches that publish (default: first push branch)." },
                            "tags": { "type": "boolean", "description": "Publish semver images on v* tags (default true)." },
                            "platforms": { "type": "array", "items": { "type": "string" }, "description": "Default [linux/amd64]." }
                          }
                        }
                      ],
                      "description": "Push images to ghcr.io/<owner>/<repo>[-<name>] after every gate passes (GITHUB_TOKEN, packages: write)."
                    }
                  }
                }
              ],
              "description": "A scalar sets build."
            },
            "compose_smoke": {
              "anyOf": [
                { "$ref": "#/$defs/gateMode" },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "mode": { "$ref": "#/$defs/gateMode" },
                    "file": { "type": "string" },
                    "services": { "type": "array", "items": { "type": "string" } },
                    "check": { "type": "string", "description": "Command run after services are healthy (e.g. npm run rabbit:check)." }
                  }
                }
              ]
            },
            "e2e": { "$ref": "#/$defs/gateMode" },
            "iac": { "$ref": "#/$defs/gateMode" },
            "commitlint": { "$ref": "#/$defs/gateMode" },
            "openapi": { "$ref": "#/$defs/gateMode" },
            "codeql": { "$ref": "#/$defs/gateMode" },
            "dependency_review": {
              "anyOf": [
                { "$ref": "#/$defs/gateMode" },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "mode": { "$ref": "#/$defs/gateMode" },
                    "severity": { "enum": ["low", "moderate", "high", "critical"] }
                  }
                }
              ],
              "description": "actions/dependency-review-action on PRs (private repos need GitHub Advanced Security)."
            },
            "secrets_scan": { "$ref": "#/$defs/gateMode", "description": "gitleaks over the pushed/PR commit range (respects .gitleaks.toml)." },
            "pr_checks": {
              "anyOf": [
                { "$ref": "#/$defs/gateMode" },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "mode": { "$ref": "#/$defs/gateMode", "description": "Default for branch_name, title and card_link." },
                    "branch_name": { "$ref": "#/$defs/patternGate" },
                    "title": { "$ref": "#/$defs/patternGate" },
                    "card_link": { "$ref": "#/$defs/patternGate" },
                    "size": {
                      "anyOf": [
                        { "$ref": "#/$defs/gateMode" },
                        { "type": "integer", "minimum": 1 },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": { "mode": { "$ref": "#/$defs/gateMode" }, "max": { "type": "integer", "minimum": 1 } }
                        }
                      ],
                      "description": "Max changed lines (default 800). A number means warn above it."
                    }
                  }
                }
              ],
              "description": "PR hygiene: branch name, Conventional Commits title, CARD_ID link, diff size."
            },
            "lighthouse": {
              "anyOf": [
                { "$ref": "#/$defs/gateMode" },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "mode": { "$ref": "#/$defs/gateMode" },
                    "app": { "type": "string" },
                    "dist": { "type": "string" },
                    "start": { "type": "string" },
                    "url": { "type": "string" },
                    "urls": { "type": "array", "items": { "type": "string" } },
                    "min": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "performance": { "type": "number", "minimum": 0, "maximum": 1 },
                        "accessibility": { "type": "number", "minimum": 0, "maximum": 1 },
                        "best-practices": { "type": "number", "minimum": 0, "maximum": 1 },
                        "seo": { "type": "number", "minimum": 0, "maximum": 1 }
                      }
                    }
                  }
                }
              ],
              "description": "Lighthouse CI on the detected web app (static dist or start command)."
            },
            "a11y": {
              "anyOf": [
                { "$ref": "#/$defs/gateMode" },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "mode": { "$ref": "#/$defs/gateMode" },
                    "app": { "type": "string" },
                    "dist": { "type": "string" },
                    "start": { "type": "string" },
                    "url": { "type": "string" },
                    "urls": { "type": "array", "items": { "type": "string" } }
                  }
                }
              ],
              "description": "axe-core accessibility check on the served web app."
            },
            "bundle_size": {
              "anyOf": [
                { "$ref": "#/$defs/gateMode" },
                { "type": "object", "additionalProperties": false, "properties": { "mode": { "$ref": "#/$defs/gateMode" }, "app": { "type": "string" } } }
              ],
              "description": "size-limit budget (or apps.<name>.commands.bundle_size)."
            },
            "mobile_build": {
              "anyOf": [
                { "$ref": "#/$defs/gateMode" },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "mode": { "$ref": "#/$defs/gateMode" },
                    "app": { "type": "string" },
                    "android": { "type": "boolean" },
                    "ios": { "type": "boolean", "description": "macOS runner (10x minutes); default false." }
                  }
                }
              ],
              "description": "Debug APK (Flutter/Android Gradle) and unsigned iOS build."
            },
            "notify": {
              "anyOf": [
                { "enum": ["off", "failure", "always", true, false] },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "on": { "enum": ["off", "failure", "always"] },
                    "slack": { "type": "boolean" },
                    "discord": { "type": "boolean" }
                  }
                }
              ],
              "description": "Slack/Discord webhook on push runs (secrets SLACK_WEBHOOK_URL / DISCORD_WEBHOOK_URL; skipped when unset)."
            },
            "docs": {
              "anyOf": [
                { "$ref": "#/$defs/gateMode" },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "mode": { "$ref": "#/$defs/gateMode" },
                    "links": { "$ref": "#/$defs/gateMode" },
                    "external": { "type": "boolean", "description": "Check http(s) links too (default offline only)." },
                    "markdown": { "$ref": "#/$defs/gateMode" }
                  }
                }
              ],
              "description": "lychee link check and markdownlint."
            }
          }
        }
      }
    },
    "management": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional project management backend contract (used by integration-bridge and cards-sync multi-backend adapters).",
      "properties": {
        "backend": {
          "type": "string",
          "enum": ["github", "jira", "azure-devops", "linear", "gitlab", "none"],
          "description": "Target project management backend."
        },
        "status_map": {
          "type": "object",
          "description": "Map Hyperion card status → backend-native status name (optional; fuzzy match used when absent).",
          "additionalProperties": { "type": "string" }
        },
        "url": {
          "type": "string",
          "description": "Jira base URL."
        },
        "project_key": {
          "type": "string",
          "description": "Jira project key."
        },
        "email": {
          "type": "string",
          "description": "Optional email used for some auth flows."
        },
        "org": {
          "type": "string",
          "description": "Azure DevOps organization URL."
        },
        "project": {
          "type": "string",
          "description": "Azure DevOps project name."
        },
        "team": {
          "type": "string",
          "description": "Linear team identifier."
        },
        "project_url": {
          "type": "string",
          "description": "GitLab project URL."
        },
        "owner": {
          "type": "string",
          "description": "GitHub owner/login (optional; can be auto-detected)."
        },
        "repo": {
          "type": "string",
          "description": "GitHub repository name (optional; can be auto-detected)."
        }
      },
      "required": ["backend"]
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "description": "Repo-adaptive shell commands for agents (test, lint, build, audit). Discovery fills defaults when omitted.",
      "properties": {
        "test": { "type": "string", "description": "Run tests (e.g. npm test, pytest)" },
        "lint": { "type": ["string", "null"], "description": "Lint command if available. null means intentionally unset." },
        "build": { "type": ["string", "null"], "description": "Build command if available. null means intentionally unset." },
        "audit": { "type": "string", "description": "Dependency audit command" }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "description": "Persistent memory capture settings for agents.",
      "properties": {
        "auto_capture": {
          "type": "boolean",
          "description": "Append session decisions to DECISIONS.md after agent runs."
        },
        "decisions_file": {
          "type": "string",
          "description": "Path to decisions log (default .github/memory/DECISIONS.md)."
        },
        "project_file": {
          "type": "string",
          "description": "Path to project context file."
        }
      }
    },
    "uncertainties": {
      "type": "array",
      "description": "Open questions Configure mode (/discover, /migrate) couldn't resolve automatically — surfaced to the user instead of guessed.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "description": "Local, opt-in usage telemetry for the agent gates (phase/review/audit/plan/spec-review/release-verify). Off by default; never leaves the machine.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "When true, agent-gate verify scripts append an event to .github/plans/telemetry/usage.jsonl (gitignored)."
        }
      }
    }
  },
  "$defs": {
    "gateMode": {
      "enum": ["off", "warn", "block", true, false],
      "description": "off=not run; warn=runs, never fails the pipeline; block=fails the pipeline. true=block, false=off."
    },
    "fixableGate": {
      "anyOf": [
        { "$ref": "#/$defs/gateMode" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": { "$ref": "#/$defs/gateMode" },
            "fix": {
              "enum": ["off", "suggest", "commit", true, false],
              "description": "PR auto-fix: suggest=review suggestions (reviewdog); commit=push the fix to the PR branch (secrets.HYPERION_PR_TOKEN re-triggers CI). Fork PRs are skipped."
            }
          }
        }
      ]
    },
    "patternGate": {
      "anyOf": [
        { "$ref": "#/$defs/gateMode" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": { "mode": { "$ref": "#/$defs/gateMode" }, "pattern": { "type": "string", "description": "Bash ERE." } }
        }
      ]
    },
    "gateSet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lint": { "$ref": "#/$defs/fixableGate" },
        "format": { "$ref": "#/$defs/fixableGate" },
        "typecheck": { "$ref": "#/$defs/gateMode" },
        "test": { "$ref": "#/$defs/gateMode" },
        "build": { "$ref": "#/$defs/gateMode" },
        "migrations": { "$ref": "#/$defs/gateMode" },
        "coverage": {
          "anyOf": [
            { "$ref": "#/$defs/gateMode" },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": { "$ref": "#/$defs/gateMode" },
                "metric": { "type": "string", "enum": ["lines", "statements", "branches", "functions"] },
                "min": { "type": "number", "minimum": 0, "maximum": 100 },
                "ignore": { "type": "array", "items": { "type": "string" }, "description": "Globs/substrings excluded from the metric." },
                "report": { "type": "string", "description": "Report path relative to the app (auto-detected when omitted)." },
                "comment": { "type": "boolean", "description": "Sticky PR comment with the coverage summary." },
                "diff": {
                  "anyOf": [
                    { "$ref": "#/$defs/gateMode" },
                    { "type": "number", "minimum": 0, "maximum": 100 },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "mode": { "$ref": "#/$defs/gateMode" },
                        "min": { "type": "number", "minimum": 0, "maximum": 100 }
                      }
                    }
                  ],
                  "description": "Coverage of lines changed by the PR (needs a line-level report: lcov, Cobertura, Go cover, coverage-final.json). A number is the minimum %."
                }
              }
            }
          ]
        },
        "audit": {
          "anyOf": [
            { "$ref": "#/$defs/gateMode" },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": { "$ref": "#/$defs/gateMode" },
                "level": { "type": "string", "enum": ["low", "moderate", "high", "critical"] },
                "fix": {
                  "enum": ["off", "check", "pr", true, false],
                  "description": "off; check=apply fix in CI, run tests, revert, warn only; pr=scheduled job opens a PR with the fix."
                }
              }
            }
          ]
        },
        "services": {
          "anyOf": [
            { "enum": ["auto", "off", true, false] },
            { "type": "array", "items": { "enum": ["postgres", "mysql", "mariadb", "mongo", "redis", "rabbitmq"] } },
            {
              "type": "object",
              "propertyNames": { "enum": ["postgres", "mysql", "mariadb", "mongo", "redis", "rabbitmq"] },
              "additionalProperties": { "type": ["string", "boolean"] },
              "description": "Kind → image (or true for the default image)."
            }
          ],
          "description": "Service containers for tests (Linux runners). auto=what pipeline-gates detected; exports DATABASE_URL/REDIS_URL/… to the job."
        },
        "migrate": {
          "type": ["boolean", "string"],
          "description": "Apply migrations to the test database before tests (true=detected command, or a command)."
        },
        "retry": { "type": "integer", "minimum": 0, "maximum": 3, "description": "Retry the test step N times (flaky tests)." },
        "matrix": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "versions": { "type": "array", "items": { "type": ["string", "number"] }, "description": "Toolchain versions; coverage/audit run on the first." },
            "os": { "type": "array", "items": { "type": "string" }, "description": "runs-on labels (services need Linux)." }
          }
        },
        "version": { "type": ["string", "number"], "description": "Pin the toolchain version (overrides detection)." },
        "runner": { "type": "string" },
        "timeout_minutes": { "type": "integer", "minimum": 1 },
        "affected_paths": { "type": "array", "items": { "type": "string" }, "description": "Extra paths that mark this app as changed." }
      }
    },
    "gateApp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "stack": { "type": "string" },
        "enabled": { "$ref": "#/$defs/gateMode" },
        "lint": { "$ref": "#/$defs/gateSet/properties/lint" },
        "format": { "$ref": "#/$defs/gateSet/properties/format" },
        "typecheck": { "$ref": "#/$defs/gateSet/properties/typecheck" },
        "test": { "$ref": "#/$defs/gateSet/properties/test" },
        "build": { "$ref": "#/$defs/gateSet/properties/build" },
        "migrations": { "$ref": "#/$defs/gateSet/properties/migrations" },
        "coverage": { "$ref": "#/$defs/gateSet/properties/coverage" },
        "audit": { "$ref": "#/$defs/gateSet/properties/audit" },
        "services": { "$ref": "#/$defs/gateSet/properties/services" },
        "migrate": { "$ref": "#/$defs/gateSet/properties/migrate" },
        "retry": { "$ref": "#/$defs/gateSet/properties/retry" },
        "matrix": { "$ref": "#/$defs/gateSet/properties/matrix" },
        "version": { "$ref": "#/$defs/gateSet/properties/version" },
        "runner": { "$ref": "#/$defs/gateSet/properties/runner" },
        "timeout_minutes": { "$ref": "#/$defs/gateSet/properties/timeout_minutes" },
        "affected_paths": { "$ref": "#/$defs/gateSet/properties/affected_paths" },
        "commands": {
          "type": "object",
          "description": "Command overrides per gate (install, lint, format, typecheck, test, coverage, build, audit, audit_fix, migrations, migrate, lint_fix, format_fix, bundle_size).",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "root": {
          "type": "string",
          "description": "Application root directory."
        },
        "manifest": {
          "type": "string",
          "description": "Primary package/project manifest (package.json, pyproject.toml, …)."
        },
        "source_dirs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Source directories under this app."
        },
        "test_dirs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Optional test directories."
        },
        "orm": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "description": "ORM / data-layer kind (prisma, drizzle, sequelize, django, …)."
            },
            "schema": {
              "type": "string",
              "description": "Path to schema or models entry file."
            },
            "migrations": {
              "type": "string",
              "description": "Optional migrations directory."
            }
          }
        }
      }
    }
  }
}
