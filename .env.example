# Hyperion — environment variables (copy to .env and fill in)
#
# Usage:
#   cp .env.example .env
#   # edit .env with your values
#
# Local load (optional — Node does NOT auto-load .env; use your shell or a loader):
#   Windows PowerShell:  Get-Content .env | ForEach-Object { ... }  OR set vars manually
#   Linux/macOS:         export $(grep -v '^#' .env | xargs)
#
# In GitHub Actions: use Repository Secrets instead of .env

# =============================================================================
# GitHub (default backend — cards-sync)
# =============================================================================

# Auto-detected from `git remote` when omitted. Format: owner/repo
# GITHUB_REPOSITORY=my-org/my-repo

# GitHub (default) — requires authenticated API access
#
# Recommended (local): install GitHub CLI and login
#   Tutorial: .github/docs/integration/github-cli-setup.md
#   Commands:  gh auth login && gh auth status
#
# Alternative: paste a PAT here (less automatic than gh)
# GITHUB_TOKEN=ghp_xxxxxxxx

# Optional PAT override when GITHUB_TOKEN lacks Projects scope (user-level Projects)
# PROJECT_SYNC_TOKEN=ghp_xxxxxxxx

# Override project target (otherwise read from .github/cards/config/projects-map.json).
# The cards:* scripts load .env.local and .env on their own (never in CI; exported
# variables win; only keys the Hyperion scripts read are loaded, never your app's
# own settings) — bind a board here instead of committing projectNumber.
# PROJECT_OWNER=my-org
# PROJECT_NUMBER=7

# =============================================================================
# Cards sync behavior
# =============================================================================

# Backend: github (default) | jira | azure-devops | linear | gitlab
# CARDS_SYNC_BACKEND=github

# forward (default) | reverse
# SYNC_DIRECTION=forward

# true = simulate without remote changes
# DRY_RUN=false

# Auto-create missing GitHub labels (default: true)
# CREATE_MISSING_LABELS=true

# =============================================================================
# Jira backend (when CARDS_SYNC_BACKEND=jira)
# =============================================================================

# JIRA_URL=https://your-org.atlassian.net
# JIRA_PROJECT_KEY=PROJ
# JIRA_EMAIL=you@company.com
# JIRA_API_TOKEN=your_atlassian_api_token
# JIRA_ISSUE_TYPE=Task

# =============================================================================
# Azure DevOps backend (when CARDS_SYNC_BACKEND=azure-devops)
# =============================================================================

# AZDO_ORG_URL=https://dev.azure.com/your-org
# AZDO_PROJECT=MyProject
# AZDO_PAT=your_azure_devops_pat
# AZDO_WORK_ITEM_TYPE=Task

# =============================================================================
# Linear backend (when CARDS_SYNC_BACKEND=linear)
# =============================================================================

# LINEAR_TEAM_ID=your-team-uuid
# LINEAR_API_TOKEN=lin_api_xxxxxxxx

# =============================================================================
# GitLab backend (when CARDS_SYNC_BACKEND=gitlab)
# =============================================================================

# GITLAB_URL=https://gitlab.com
# GITLAB_PROJECT_ID=12345678
# GITLAB_TOKEN=glpat-xxxxxxxx
# GITLAB_ISSUE_TYPE=
