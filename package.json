{
  "name": "hyperion",
  "version": "0.1.0",
  "private": true,
  "description": "Hyperion — portable AI agents and skills for software projects",
  "repository": {
    "type": "git",
    "url": "https://github.com/MatheusFelipeCorrea/Hyperion.git"
  },
  "homepage": "https://github.com/MatheusFelipeCorrea/Hyperion",
  "type": "module",
  "scripts": {
    "hyperion:help": "node scripts/hyperion/help.mjs",
    "hyperion:doctor": "node scripts/hyperion/doctor.mjs",
    "hyperion:setup": "node scripts/hyperion/setup.mjs",
    "hyperion:sync": "node scripts/hyperion/sync.mjs",
    "hyperion:cursor": "node scripts/hyperion/install-cursor-rules.mjs",
    "hyperion:pipeline-detect": "node scripts/hyperion/pipeline-detect.mjs",
    "hyperion:pipeline-plan": "node scripts/hyperion/pipeline-plan.mjs",
    "hyperion:pipeline-apply": "node scripts/hyperion/pipeline-apply.mjs",
    "hyperion:generate-rules": "node scripts/hyperion/generate-runtime-rules.mjs",
    "hyperion:check-rules": "node scripts/hyperion/generate-runtime-rules.mjs --check",
    "docs:check": "node scripts/hyperion/docs-check.mjs",
    "skills:validate": "node scripts/hyperion/skills-validate.mjs",
    "hyperion:repo-detect": "node scripts/hyperion/repo-detect.mjs",
    "hyperion:skills-eval": "node scripts/hyperion/skills-eval.mjs",
    "hyperion:skills-catalog": "node scripts/hyperion/skills-catalog.mjs",
    "hyperion:phase-verify": "node scripts/hyperion/phase-verify.mjs",
    "hyperion:project-verify": "node scripts/hyperion/project-verify.mjs",
    "hyperion:review-verify": "node scripts/hyperion/review-verify.mjs",
    "hyperion:init": "node scripts/hyperion/init.mjs",
    "hyperion:upgrade": "node scripts/hyperion/upgrade.mjs",
    "hyperion:cli": "node scripts/hyperion/cli.mjs",
    "hyperion:docker-build": "docker build -t hyperion-cli -f Dockerfile .",
    "cards:init": "node scripts/cards-sync/init.mjs",
    "cards:validate": "node scripts/cards-sync/validate.mjs",
    "cards:sync": "node scripts/cards-sync/sync.mjs",
    "cards:dry-run": "node scripts/cards-sync/sync.mjs --dry-run",
    "cards:reverse": "node scripts/cards-sync/sync.mjs --reverse",
    "cards:doctor": "node scripts/cards-sync/doctor.mjs --interactive",
    "cards:watch": "node scripts/cards-sync/watch.mjs",
    "cards:hook": "node scripts/cards-sync/install-hook.mjs",
    "cards:labels-reset": "node scripts/cards-sync/labels-reset.mjs",
    "cards:migrate-layout": "node scripts/cards-sync/migrate-layout.mjs",
    "cards:test": "node --test scripts/cards-sync/*.test.mjs",
    "hyperion:test": "node --test scripts/hyperion/*.test.mjs",
    "test": "npm run hyperion:test && npm run cards:test"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "hyperion": "./scripts/hyperion/cli.mjs"
  }
}
