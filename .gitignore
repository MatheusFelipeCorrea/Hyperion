# Gitignore — generated session artifacts (keep folder scaffolds only)

# Audit results
.github/audits/results/*
!.github/audits/results/.gitkeep

# Plans — generated per session
.github/plans/implementations/*
!.github/plans/implementations/.gitkeep
.github/plans/specs/*
!.github/plans/specs/.gitkeep
.github/plans/reviews/*
!.github/plans/reviews/.gitkeep
.github/plans/migrations/*
!.github/plans/migrations/.gitkeep
.github/plans/releases/*
!.github/plans/releases/.gitkeep
.github/plans/cards/last-sync.md
.github/plans/cards/sync-history.jsonl
.github/plans/telemetry/usage.jsonl

# hyperion:upgrade backs up any managed file it's about to overwrite here
# before applying — see PRESERVE_PREFIXES / backup-before-overwrite in upgrade-lib.mjs
.hyperion-upgrade-backup/

# OS files
.DS_Store
Thumbs.db

# Node
node_modules/

# Environment
.env
.env.local
